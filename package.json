{
  "name": "pi-scroll",
  "version": "0.1.0",
  "private": false,
  "description": "Pi package that adds a /scroll session history search command",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "scroll",
    "session-search"
  ],
  "files": [
    "README.md",
    "extensions",
    "src",
    "assets"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "packageManager": "pnpm@11.2.2",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://unpkg.com/pi-scroll@0.1.0/assets/screenshot.png"
  }
}
